{
  "name": "hexo-theme-stellar-examples",
  "private": true,
  "description": "Hexo 8 monorepo for Stellar Blueprint demos and acceptance.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "case4011-lightblog",
    "case4012-minimalblog",
    "case4021-knowledge",
    "case4031-docs",
    "case4041-notebook"
  ],
  "scripts": {
    "start": "node main.mjs",
    "start:all": "node scripts/examples.mjs start-all",
    "artifacts": "node scripts/blueprint-artifacts.mjs build",
    "clean": "node scripts/examples.mjs clean",
    "dev": "node scripts/examples.mjs dev",
    "doctor": "node scripts/examples.mjs doctor",
    "build": "node scripts/examples.mjs build",
    "check:structure": "node scripts/examples.mjs check-structure",
    "check:blueprints": "node scripts/blueprint-artifacts.mjs check",
    "check:outputs": "node scripts/examples.mjs check-outputs",
    "check": "npm test && npm run check:blueprints && node scripts/examples.mjs check",
    "deploy": "node scripts/examples.mjs deploy",
    "test": "node --test"
  }
}
